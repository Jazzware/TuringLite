<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- Debe ser false: en modo invariante WinForms no puede resolver el idioma de entrada (p. ej. es-MX, LCID 2058)
         y se cae al cambiar de teclado. Los formatos de la app usan CultureInfo.InvariantCulture, así que no cambian. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TuringLite</AssemblyName>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <InformationalVersion>1.0.3</InformationalVersion>
    <Product>TuringLite</Product>
    <Company>TuringLite</Company>
    <Description>Monitor de hardware para la pantalla USB Turing Smart Screen</Description>
    <Copyright>Copyright © 2026 TuringLite</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- Equivale a UseWindowsForms; así compila también con SDKs sin el componente de escritorio -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <!-- El instalador y los scripts de release tienen su propio proyecto o no son código de la app. -->
    <Compile Remove="setup\**;dist\**;release\**" />
    <EmbeddedResource Remove="setup\**;dist\**;release\**" />
    <None Remove="setup\**;dist\**;release\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="status.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Las licencias de terceros (MPL-2.0, Apache-2.0) piden acompañar el programa con sus avisos. -->
    <None Update="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
