<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Instalador de TuringLite. Lleva la app dentro (dist\payload.zip, lo genera release\build-release.ps1).
    Usa .NET Framework 4.8, que viene con Windows 10 (1809 o posterior) y Windows 11: así arranca siempre, también
    en equipos sin .NET 8, y puede comprobar que la app tendrá su runtime antes de instalar nada.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 64 bits: Program Files y el registro se ven igual que desde la app, y se puede leer la ruta de sus procesos. -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TuringLite-Setup</AssemblyName>
    <RootNamespace>TuringLite.Setup</RootNamespace>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>TuringLite</Product>
    <Description>Instalador de TuringLite</Description>
    <Copyright>Copyright © 2026 TuringLite</Copyright>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\dist\payload.zip" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
