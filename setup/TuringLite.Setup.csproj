<Project Sdk="Microsoft.NET.Sdk">
  <!-- Instalador de TuringLite. Lleva la app dentro (dist\payload.zip, lo genera release\build-release.ps1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TuringLite-Setup</AssemblyName>
    <RootNamespace>TuringLite.Setup</RootNamespace>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>TuringLite</Product>
    <Description>Instalador de TuringLite</Description>
    <Copyright>Copyright © 2026 TuringLite</Copyright>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\dist\payload.zip" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
